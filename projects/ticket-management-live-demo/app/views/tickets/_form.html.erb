<% if ticket.errors.any? %>
  <div class="errors">
    <strong><%= pluralize(ticket.errors.count, "error") %> prevented this ticket from being saved:</strong>
    <ul>
      <% ticket.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: ticket) do |form| %>
  <%= form.label :title %>
  <%= form.text_field :title %>

  <%= form.label :customer_email %>
  <%= form.email_field :customer_email %>

  <%= form.label :priority %>
  <%= form.select :priority, Ticket::PRIORITIES.map { |priority| [priority.humanize, priority] } %>

  <%= form.label :status %>
  <%= form.select :status, Ticket::STATUSES.map { |status| [status.humanize, status] } %>

  <%= form.label :description %>
  <%= form.text_area :description %>

  <p>
    <%= form.submit %>
    <%= link_to "Cancel", tickets_path, class: "button secondary" %>
  </p>
<% end %>
